# bm-hr environment

# Postgres — the SCOPED role for the hr schema (bm_hr_svc), never a shared
# admin credential. See scripts/create-role.sql. Supabase URLs get SSL
# automatically.
DATABASE_URL=postgres://bm_hr_svc:pass@host:5432/postgres

# Session cookie signing secret (32+ random chars).
JWT_SECRET=change-me-to-a-random-string-of-32-plus-characters

# Fleet identity service (bm-identity). The secret is THIS app's bearer, issued
# when the app was onboarded (Secret Manager: bm-identity-secret-hr). Without
# both values every sign-in answers 501 — there is no local login policy.
IDENTITY_API_URL=https://bm-identity-414540960371.asia-southeast1.run.app
IDENTITY_API_SECRET=

# Google OAuth client id for THIS app's sign-in button (public by nature; the
# JS origin must be the HR app URL). Registered on the identity.apps row too.
GOOGLE_LOGIN_CLIENT_ID=

PORT=8080
NODE_ENV=development
